<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>com.apple.security.app-sandbox</key><true/>
<key>com.apple.security.files.user-selected.read-write</key><true/>
<!-- Finder supplies the target folder. These exceptions allow creation there,
     and reading the host's new-file.json, without a separate folder chooser.
     TCC permissions still apply. This is a locally distributed, non-MAS app. -->
<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
<array><string>/Users/</string><string>/Volumes/</string><string>/private/tmp/</string></array>
</dict></plist>
